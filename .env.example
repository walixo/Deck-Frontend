# Where the API lives — the ORIGIN, with no /api on the end.
#
#   VITE_API_BASE_URL=https://deck-backend-9js1.onrender.com
#
# Vite inlines this at BUILD time, so it has to be set wherever the build runs
# (Vercel's project settings), not at runtime. Changing it means rebuilding.
#
# Leave it unset and the app calls a relative /api instead, which is what local
# development wants: `npm run dev` proxies /api to localhost:4200, so the
# browser stays on one origin and never meets CORS. Setting it in a local .env
# therefore points your dev server at production — usually not what you want.
#
# When it IS set the calls are cross-origin, so the API's CLIENT_ORIGIN must
# name this site or the browser blocks every request.
# VITE_API_BASE_URL=

# Google AdSense. Both must be set for any Google unit to appear, and even
# then the script only loads once a reader has agreed in the consent banner.
# Leave them unset and Deck makes no third-party request at all — the banner
# does not appear either, because there is nothing to consent to.
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=1234567890
