# Google AdSense. Both must be set for any Google unit to appear, and even
# then the script only loads once a reader has agreed in the consent banner.
# Leave them unset and Deck makes no third-party request at all — the banner
# does not appear either, because there is nothing to consent to.
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=1234567890
