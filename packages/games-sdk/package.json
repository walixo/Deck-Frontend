{
  "name": "@onedeck/games-sdk",
  "version": "1.1.0",
  "description": "The Deck Games SDK: sign-in, purchases, scores, leaderboards and multiplayer rooms for web games on Deck.",
  "keywords": [
    "deck",
    "onedeck",
    "games",
    "sdk",
    "multiplayer",
    "html5",
    "threejs",
    "phaser"
  ],
  "homepage": "https://onedeck.africa/docs/developers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  }
}
